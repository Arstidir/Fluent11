<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ControlTemplate x:Key="ComboBoxListBaseTemplate" TargetType="{x:Type ComboBoxListBase}">
        <Border BorderThickness="{DynamicResource ControlBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Style="{DynamicResource HighlightBorder}"
                Background="{TemplateBinding Background}"
                x:Name="Root">
            <Grid>
                <DockPanel>
                    <TextBlock x:Name="Chevron" Text="&#xE70D;" DockPanel.Dock="Right" Margin="0,0,11,0"
                               FontFamily="{DynamicResource FluentIconFont}" FontSize="12"
                               Foreground="{DynamicResource TextBrushDarker}"
                               VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="PART_TextFilterString"
                               Style="{StaticResource BaseTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" 
                               VerticalAlignment="Center" DockPanel.Dock="Left"
                               Margin="11,0,0,0"/>
                </DockPanel>
                <ToggleButton x:Name="MainToggle"
                              BorderThickness="0" Focusable="False"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button x:Name="PART_ButtonClearFilter"
                        Margin="0,0,32,0" FontSize="10"
                        Background="Transparent" HorizontalAlignment="Right"
                        BorderThickness="0" Padding="3,0,3,0"
                        ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup Placement="Bottom" HorizontalOffset="-8" Focusable="False" Name="Popup" Tag="Fluent11Acrylic"
                       AllowsTransparency="{DynamicResource Fluent11PopupTransparent}"
                       IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                       MaxHeight="300">
                    <Grid Style="{DynamicResource PopupRoot}">
                        <Border x:Name="SubShadow" Style="{DynamicResource PopupShadow}" />
                        <Border x:Name="SubCard" Style="{DynamicResource PopupBorder}" MinWidth="{Binding ActualWidth, ElementName=MainToggle}">
                            <ItemsControl x:Name="PART_ItemsPanel" />
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="False">
                <Setter TargetName="SubShadow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SubCard" Property="Margin" Value="0" />
                <Setter TargetName="SubCard" Property="BorderBrush" Value="{DynamicResource PopupAcrylicBorderBrush}" />
                <Setter TargetName="SubCard" Property="Background" Value="{DynamicResource PopupAcrylicBrush}" />
                <Setter TargetName="Popup" Property="HorizontalOffset" Value="0" />
                <Setter TargetName="Popup" Property="VerticalOffset" Value="4" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, ElementName=MainToggle}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="3">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="FilterComboBoxListTemplate" TargetType="{x:Type ComboBoxListBase}">
        <Border BorderThickness="{DynamicResource ControlBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Style="{DynamicResource HighlightBorder}"
                Background="{TemplateBinding Background}"
                x:Name="Root">
            <Grid>
                <DockPanel>
                    <TextBlock x:Name="Chevron" Text="&#xE70D;" DockPanel.Dock="Right" Margin="0,0,11,0"
                               FontFamily="{DynamicResource FluentIconFont}" FontSize="12"
                               Foreground="{DynamicResource TextBrushDarker}"
                               VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="PART_TextFilterString"
                               Style="{StaticResource BaseTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" 
                               VerticalAlignment="Center" DockPanel.Dock="Left"
                               Margin="11,0,0,0"/>
                </DockPanel>
                <ToggleButton x:Name="MainToggle"
                              BorderThickness="0" Focusable="False"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button x:Name="PART_ButtonClearFilter"
                        Margin="0,0,32,0" FontSize="10"
                        Background="Transparent" HorizontalAlignment="Right"
                        BorderThickness="0" Padding="3,0,3,0"
                        ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup Placement="Bottom" HorizontalOffset="-8" Focusable="False" Name="Popup" Tag="Fluent11Acrylic"
                       AllowsTransparency="{DynamicResource Fluent11PopupTransparent}"
                       IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                       MaxHeight="300">
                    <Grid Style="{DynamicResource PopupRoot}">
                        <Border x:Name="SubShadow" Style="{DynamicResource PopupShadow}" />
                        <Border x:Name="SubCard" Style="{DynamicResource PopupBorder}" MinWidth="{Binding ActualWidth, ElementName=MainToggle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="5" Name="PART_ElemSearchHost">                                
                                    <CheckBox DockPanel.Dock="Right"
                                              x:Name="PART_ToggleSelectedOnly"
                                              ToolTip="{DynamicResource LOCOnlyItemsSelectedTooltip}"
                                              FontFamily="{DynamicResource FontIcoFont}" />
                                    <SearchBox DockPanel.Dock="Left" Margin="0,0,5,0" x:Name="PART_SearchBox" />
                                </DockPanel>
                                <ItemsControl x:Name="PART_ItemsPanel" Grid.Row="1" />
                            </Grid>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="False">
                <Setter TargetName="SubShadow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SubCard" Property="Margin" Value="0" />
                <Setter TargetName="SubCard" Property="BorderBrush" Value="{DynamicResource PopupAcrylicBorderBrush}" />
                <Setter TargetName="SubCard" Property="Background" Value="{DynamicResource PopupAcrylicBrush}" />
                <Setter TargetName="Popup" Property="HorizontalOffset" Value="0" />
                <Setter TargetName="Popup" Property="VerticalOffset" Value="4" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChecked, ElementName=MainToggle}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chevron" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="3">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ComboBoxListItemStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Padding" Value="8,6" />
    </Style>
    
    <Style TargetType="{x:Type ComboBoxList}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="Template" Value="{DynamicResource ComboBoxListBaseTemplate}" />
    </Style>
    
    <Style TargetType="{x:Type DdItemListSelectionBox}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="Template" Value="{DynamicResource FilterComboBoxListTemplate}" />        
    </Style>
</ResourceDictionary>