<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{TemplateBinding Background}" Grid.ColumnSpan="2"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <ProgressBar x:Name="PART_ProgressStatus" Grid.ColumnSpan="2"
                                     BorderThickness="0" Background="Transparent" Height="3" Margin="8,0,8,2"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        <Border x:Name="Indicator" Visibility="Collapsed" Grid.ColumnSpan="2"
                                Width="3" Height="16" CornerRadius="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                        </Border>
                        <Viewbox x:Name="IconHost" Width="16" Height="16">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Viewbox>
                        <Path x:Name="CustomIcon" Visibility="Collapsed" Width="16" Height="16" Stretch="Uniform"
                              Fill="{TemplateBinding Foreground}" />
                        <TextBlock x:Name="Label" Grid.Column="1" Visibility="Collapsed" Text="{Binding Title}"
                                   Margin="2,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSize}"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Title}" Value="HowLongToBeat">
                            <Setter Property="Data" Value="{DynamicResource FluentTimerGeometry}" TargetName="CustomIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="CustomIcon" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Title}" Value="Playnite Achievements">
                            <Setter Property="Data" Value="{DynamicResource FluentTrophyGeometry}" TargetName="CustomIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="CustomIcon" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Indicator" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Selected}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                <Setter Property="ToolTipService.IsEnabled" Value="False" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Title}" Value="Playnite Achievements" />
                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=ShowAchievementsPage, FallbackValue=False}" Value="True" />
                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=HidePlayniteAchievementsEntry, FallbackValue=False}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="MaxHeight" Value="0" />
                <Setter Property="MaxWidth" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon" />
                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=ShowStatisticsPage, FallbackValue=False}" Value="True" />
                    <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=HideStatisticsEntry, FallbackValue=False}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="MaxHeight" Value="0" />
                <Setter Property="MaxWidth" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </MultiDataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleSelectedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                <Setter Property="Width" Value="Auto" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource CriticalBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
