<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="FillBorder" Background="{DynamicResource ControlFillBrush}"
                                BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="BottomLine" BorderBrush="{DynamicResource ControlStrongStrokeBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource FluentIconFont}" FontSize="14"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                   Visibility="{Binding ShowImage, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ContentControl x:Name="PART_SeachIcon" Width="0" Opacity="0" IsHitTestVisible="False"
                                                        ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                        <TextBlock x:Name="Prompt" Text="{TemplateBinding Tag}" Visibility="Collapsed"
                                   VerticalAlignment="Center" Margin="36,0,32,0" IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{DynamicResource BaseTextBlockStyle}"
                                   Foreground="{DynamicResource TextBrushDarker}" />
                        <TextBox x:Name="PART_TextInpuText"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Padding="32,0,32,0" />
                        <ContentControl x:Name="PART_ClearTextIcon"
                                        ContentTemplate="{DynamicResource ClearTextIconTemplate}" Cursor="Hand"
                                        FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,11,0"
                                        Foreground="{DynamicResource TextBrushDarker}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=PART_TextInpuText}" Value="{x:Static sys:String.Empty}">
                            <Setter Property="Visibility" Value="Visible" TargetName="Prompt" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlAltFillBrush}" TargetName="FillBorder" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlFillFocusedBrush}" TargetName="FillBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" TargetName="BottomLine" />
                            <Setter Property="BorderThickness" Value="0,0,0,2" TargetName="BottomLine" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
