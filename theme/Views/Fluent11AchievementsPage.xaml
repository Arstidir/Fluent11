<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
        <Style x:Key="AchCaption" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        </Style>
        <Style x:Key="AchText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="AchRowButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="8,5" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AchBarButton" TargetType="ButtonBase">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource FluentIconFont}" FontSize="16"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AchRarityBar" TargetType="ProgressBar" BasedOn="{StaticResource Fluent11ListProgressBar}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Minimum" Value="0" />
        </Style>
        <Style x:Key="AchStatIcon" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource SubtleSelectedBrush}" />
        </Style>
        <Style x:Key="AchStatGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FluentIconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AchRarityDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="2,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AchTab" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontWeight="SemiBold" />
                            <Border x:Name="Indicator" Width="16" Height="3" CornerRadius="1.5" Margin="0,4,0,0"
                                    HorizontalAlignment="Center" Background="{DynamicResource AccentBrush}" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             From="0" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             From="0" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AchRarityFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Rarity.Common}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rarity}" Value="Uncommon">
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Rarity.Uncommon}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Rare">
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Rarity.Rare}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="UltraRare">
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Rarity.UltraRare}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AchRarityText" TargetType="TextBlock" BasedOn="{StaticResource AchCaption}">
            <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Rarity.Common}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Text" Value="{Binding Percent, StringFormat='{}{0:0.#} %'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rarity}" Value="Uncommon">
                    <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Rarity.Uncommon}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Rare">
                    <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Rarity.Rare}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="UltraRare">
                    <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Rarity.UltraRare}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,146,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="LeftSpace" Margin="0,0,12,0" />
        <SearchBox x:Name="SearchBox" Grid.Column="1" Tag="{DynamicResource LOCSearchLabel}"
                   Width="220" Height="32" VerticalAlignment="Center"
                   WindowChrome.IsHitTestVisibleInChrome="True" />
    </Grid>
    <DockPanel Grid.Row="0" Margin="0,0,146,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
            <Grid>
                <Button Style="{StaticResource AchBarButton}" Content="&#xE71C;" Tag="AchFilterMenu" ToolTip="Filter" />
                <Ellipse x:Name="FilterDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed" />
            </Grid>
            <Button Style="{StaticResource AchBarButton}" Content="&#xE72C;"
                    ToolTip="Refresh recently played games" Command="{Binding RecentRefreshCommand}" />
        </StackPanel>
        <Border DockPanel.Dock="Right">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource TopPanelSeparator}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=SearchBox}" Value="Collapsed">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <DockPanel LastChildFill="False" ClipToBounds="True">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=LeftSpace}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=SearchBox}" Value="Collapsed">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="MaxWidth" Value="Infinity" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <TextBlock DockPanel.Dock="Left" Text="Achievements" Width="160" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="DockPanel.Dock" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=SearchBox}" Value="Collapsed">
                                <Setter Property="DockPanel.Dock" Value="Right" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock x:Name="SortText" Style="{StaticResource AchCaption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Style="{StaticResource AchBarButton}" Content="&#xE8CB;" Tag="AchSortMenu" ToolTip="Sort" />
            </StackPanel>
        </DockPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="24,20,0,0" Style="{DynamicResource Fluent11PageEntrance}" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,56,28">
            <Grid.RowDefinitions>
                <RowDefinition SharedSizeGroup="AchTopCards" />
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource SurfaceCard}" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="96" Height="96" Margin="0,0,28,0" VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource ControlStrongStrokeBrush}" StrokeThickness="8" Opacity="0.25" />
                        <Path x:Name="ProgressRing" Stroke="{DynamicResource AccentBrush}" StrokeThickness="8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock x:Name="RingPercent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="{Binding TotalOverall.Unlocked, Mode=OneWay, StringFormat='{}{0:N0}', FallbackValue=0}"
                                 FontSize="{DynamicResource FontSizeLargest}" FontWeight="SemiBold" />
                            <Run Text=" / " Foreground="{DynamicResource TextBrushDarker}" />
                            <Run Text="{Binding TotalOverall.Total, Mode=OneWay, StringFormat='{}{0:N0}', FallbackValue=0}"
                                 Foreground="{DynamicResource TextBrushDarker}" />
                        </TextBlock>
                        <TextBlock Text="achievements unlocked" Style="{StaticResource AchCaption}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,28,8">
                                <Border Style="{StaticResource AchStatIcon}">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource AchStatGlyph}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GameSummariesDesc.Count, FallbackValue=0}" FontWeight="SemiBold" />
                                    <TextBlock Text="Games" Style="{StaticResource AchCaption}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="0,0,28,8">
                                <Border Style="{StaticResource AchStatIcon}">
                                    <TextBlock Text="&#xE930;" Style="{StaticResource AchStatGlyph}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CompletedGamesDesc.Count, FallbackValue=0}" FontWeight="SemiBold" />
                                    <TextBlock Text="Completed" Style="{StaticResource AchCaption}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Grid.Column="2" Margin="0,0,0,8">
                                <Border Style="{StaticResource AchStatIcon}">
                                    <Path Data="{DynamicResource FluentTrophyGeometry}" Fill="{DynamicResource AccentBrush}"
                                          Stretch="Uniform" Width="16" Height="16" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RankText" Text="{Binding CollectorRank, FallbackValue='-'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <TextBlock Style="{StaticResource AchCaption}" TextTrimming="CharacterEllipsis">
                                        <Run Text="Level " /><Run Text="{Binding CollectorLevel, Mode=OneWay, FallbackValue=0}" />
                                    </TextBlock>
                                    <TextBlock x:Name="NextRankText" Style="{StaticResource AchCaption}" Visibility="Collapsed"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,-20,32,0" BorderThickness="0,0,1,0" IsHitTestVisible="False"
                x:Name="PanelSeparator"
                BorderBrush="{DynamicResource PanelSeparatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,32,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,12" LastChildFill="False">
                <TextBlock Text="Games" Style="{DynamicResource SectionHeaderTextBlock}" Margin="0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource AchCaption}" Margin="8,2,0,0" VerticalAlignment="Center"
                           Text="{Binding Items.Count, ElementName=GameList}" />
            </DockPanel>

            <Grid>
                <ItemsControl x:Name="GameList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                                <ItemsPresenter Margin="0,0,0,16" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AchRowButton}" Tag="OpenGameAchievements">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="{DynamicResource Fluent11ListCoverWidth}" Height="32" Margin="0,0,12,0"
                                            HorizontalAlignment="Left" CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Converter={StaticResource Fluent11ListArtConverter}}"
                                                        Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                                        </Border.Background>
                                        <Border CornerRadius="4" Style="{DynamicResource ImageStrokeOverlay}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource AchText}" />
                                            <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FluentIconFont}" FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="8,2,0,0" VerticalAlignment="Center"
                                                       ToolTip="Completed">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource AchCaption}">
                                            <Run Text="{Binding UnlockedCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding AchievementCount, Mode=OneWay}" /><Run Text=" achievements" />
                                        </TextBlock>
                                    </StackPanel>
                                    <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Style="{StaticResource AchCaption}"
                                                   Text="{Binding Progress, StringFormat='{}{0} %'}" />
                                        <ProgressBar Style="{StaticResource Fluent11ListProgressBar}" VerticalAlignment="Center" Margin="0,0,8,0" Minimum="0" Maximum="100"
                                                     Value="{Binding Progress, Mode=OneWay}" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right"
                                               Text="{Binding LastUnlockDate, StringFormat='{}{0:d}'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource AchCaption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UnlockedCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=GameList}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Data="{DynamicResource FluentTrophyGeometry}" Fill="{DynamicResource TextBrushDarker}" Stretch="Uniform" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="No games to show" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                               FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" />
                    <TextBlock Text="No games with achievements match the current options." TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextBrushDarker}" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" Padding="0,0,24,0" Margin="0,-20,0,0">
            <StackPanel Margin="0,20,0,16">
                <Grid Margin="0,0,0,28">
                    <Grid.RowDefinitions>
                        <RowDefinition SharedSizeGroup="AchTopCards" />
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource SurfaceCard}" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton x:Name="UnlockDaysTab" GroupName="AchUnlockRange" Style="{StaticResource AchTab}"
                                                 Content="Days" IsChecked="True" Margin="0,0,16,0" />
                                    <RadioButton x:Name="UnlockMonthsTab" GroupName="AchUnlockRange" Style="{StaticResource AchTab}" Content="Months" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="Unlocks" FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock x:Name="UnlockSummary" Grid.Row="1" Style="{StaticResource AchCaption}" Margin="0,0,0,8" />

                            <ItemsControl x:Name="UnlockBars" Grid.Row="2" MinHeight="56" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Column" Background="Transparent" CornerRadius="2,2,0,0"
                                                ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="100">
                                            <Grid Margin="1.5,4,1.5,0" MaxWidth="20">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="{Binding Empty}" />
                                                    <RowDefinition Height="{Binding Filled}" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="1" CornerRadius="2,2,0,0" Background="{DynamicResource AccentBrush}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Column" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Column" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="3" Height="1" Background="{DynamicResource ProgressTrackBrush}" />
                            <DockPanel Grid.Row="4" Margin="0,4,0,0">
                                <TextBlock x:Name="UnlockEnd" DockPanel.Dock="Right" Style="{StaticResource AchCaption}" />
                                <TextBlock x:Name="UnlockStart" Style="{StaticResource AchCaption}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{DynamicResource SurfaceCard}" Padding="20,16" Margin="0,0,0,28">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Rarity" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>

                            <Ellipse Grid.Row="0" Style="{StaticResource AchRarityDot}" Fill="{DynamicResource PlayAch.Brush.Rarity.Common}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Common" VerticalAlignment="Center" Style="{StaticResource AchCaption}" />
                            <ProgressBar Grid.Row="0" Grid.Column="2" Style="{StaticResource AchRarityBar}" Foreground="{DynamicResource PlayAch.Brush.Rarity.Common}"
                                         Maximum="{Binding TotalCommon.Total, Mode=OneWay, FallbackValue=1}"
                                         Value="{Binding TotalCommon.Unlocked, Mode=OneWay, FallbackValue=0}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AchCaption}"
                                       Text="{Binding TotalCommon.Stats, FallbackValue=''}" />

                            <Ellipse Grid.Row="1" Style="{StaticResource AchRarityDot}" Fill="{DynamicResource PlayAch.Brush.Rarity.Uncommon}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Uncommon" VerticalAlignment="Center" Style="{StaticResource AchCaption}" />
                            <ProgressBar Grid.Row="1" Grid.Column="2" Style="{StaticResource AchRarityBar}" Foreground="{DynamicResource PlayAch.Brush.Rarity.Uncommon}"
                                         Maximum="{Binding TotalUncommon.Total, Mode=OneWay, FallbackValue=1}"
                                         Value="{Binding TotalUncommon.Unlocked, Mode=OneWay, FallbackValue=0}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AchCaption}"
                                       Text="{Binding TotalUncommon.Stats, FallbackValue=''}" />

                            <Ellipse Grid.Row="2" Style="{StaticResource AchRarityDot}" Fill="{DynamicResource PlayAch.Brush.Rarity.Rare}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Rare" VerticalAlignment="Center" Style="{StaticResource AchCaption}" />
                            <ProgressBar Grid.Row="2" Grid.Column="2" Style="{StaticResource AchRarityBar}" Foreground="{DynamicResource PlayAch.Brush.Rarity.Rare}"
                                         Maximum="{Binding TotalRare.Total, Mode=OneWay, FallbackValue=1}"
                                         Value="{Binding TotalRare.Unlocked, Mode=OneWay, FallbackValue=0}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AchCaption}"
                                       Text="{Binding TotalRare.Stats, FallbackValue=''}" />

                            <Ellipse Grid.Row="3" Style="{StaticResource AchRarityDot}" Fill="{DynamicResource PlayAch.Brush.Rarity.UltraRare}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Ultra rare" VerticalAlignment="Center" Style="{StaticResource AchCaption}" />
                            <ProgressBar Grid.Row="3" Grid.Column="2" Style="{StaticResource AchRarityBar}" Foreground="{DynamicResource PlayAch.Brush.Rarity.UltraRare}"
                                         Maximum="{Binding TotalUltraRare.Total, Mode=OneWay, FallbackValue=1}"
                                         Value="{Binding TotalUltraRare.Unlocked, Mode=OneWay, FallbackValue=0}" />
                            <TextBlock Grid.Row="3" Grid.Column="3" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AchCaption}"
                                       Text="{Binding TotalUltraRare.Stats, FallbackValue=''}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                    <RadioButton x:Name="RecentTab" GroupName="AchRightTabs" Style="{StaticResource AchTab}"
                                 Content="Recently unlocked" IsChecked="True" />
                    <RadioButton GroupName="AchRightTabs" Style="{StaticResource AchTab}" Content="Rarest unlocked" />
                </StackPanel>

                <Border Padding="12,14,12,8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=RecentTab}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ItemsControl x:Name="Showcase" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,0,4,8" Background="Transparent">
                                    <StackPanel.ToolTip>
                                        <StackPanel MaxWidth="320">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Game.Name}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.7" />
                                        </StackPanel>
                                    </StackPanel.ToolTip>
                                    <Border Style="{StaticResource AchRarityFrame}" Width="64" Height="64" HorizontalAlignment="Center">
                                        <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"
                                               Source="{Binding Icon, Converter={StaticResource ImageStringToImageConverterCached}}">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,56,56" RadiusX="4" RadiusY="4" />
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                    <TextBlock Style="{StaticResource AchRarityText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource AchCaption}"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=RecentTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ItemsControl Focusable="False" ItemsSource="{Binding MostRecentUnlocksTop5}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5" Background="Transparent">
                                    <DockPanel.ToolTip>
                                        <StackPanel MaxWidth="320">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Game.Name}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.7" />
                                        </StackPanel>
                                    </DockPanel.ToolTip>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource AchRarityFrame}" Width="40" Height="40"
                                            BorderThickness="1.5" Padding="2" Margin="0,0,12,0">
                                        <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"
                                               Source="{Binding Icon, Converter={StaticResource ImageStringToImageConverterCached}}">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,33,33" RadiusX="3" RadiusY="3" />
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource AchRarityText}" HorizontalAlignment="Right" />
                                        <TextBlock Style="{StaticResource AchCaption}" HorizontalAlignment="Right"
                                                   Text="{Binding DateUnlocked, StringFormat='{}{0:d}'}" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource AchText}" />
                                        <TextBlock Text="{Binding Game.Name}" Style="{StaticResource AchCaption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Grid>
