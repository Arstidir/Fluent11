<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="24,24,24,24" TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
        <Style x:Key="AchCaption" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        </Style>
        <Style x:Key="AchText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="AchRarityDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.Rarity.Common}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rarity}" Value="Uncommon">
                    <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.Rarity.Uncommon}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Rare">
                    <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.Rarity.Rare}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="UltraRare">
                    <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.Rarity.UltraRare}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GlobalPercentText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GlobalPercentText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AchRarityName" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="Common" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rarity}" Value="Uncommon">
                    <Setter Property="Text" Value="Uncommon" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Rare">
                    <Setter Property="Text" Value="Rare" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="UltraRare">
                    <Setter Property="Text" Value="Ultra rare" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GlobalPercentText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GlobalPercentText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AchTab" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="GroupName" Value="AchTabs" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="TabGrid" Margin="2,4">
                            <Border x:Name="HoverFill" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <ContentPresenter Margin="12,6,12,8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Indicator" Visibility="Collapsed"
                                    Width="16" Height="3" CornerRadius="1.5" Margin="0,0,0,1"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" TargetName="HoverFill" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Visibility" Value="Visible" TargetName="Indicator" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             From="0" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             From="0" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AchTabText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style x:Key="AchIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FluentIconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,8,0" />
        </Style>
        <Style x:Key="AchBarButton" TargetType="ButtonBase">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{DynamicResource FluentIconFont}" FontSize="14"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="14" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0,0,0,1" Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
        <Border DockPanel.Dock="Left" Width="{DynamicResource Fluent11LargeCoverWidth}" Height="160" Margin="0,0,24,0"
                CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource GridItemBackgroundBrush}">
            <Border CornerRadius="{DynamicResource CardCornerRadius}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding SummaryItems[0].GameCoverPath, Converter={StaticResource ImageStringToImageConverterCached}}"
                                Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                </Border.Background>
                <Border CornerRadius="{DynamicResource CardCornerRadius}" Style="{DynamicResource ImageStrokeOverlay}" />
            </Border>
        </Border>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding GameName}" FontFamily="{DynamicResource FontFamilyDisplay}" FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       LineStackingStrategy="BlockLineHeight" LineHeight="36" MaxHeight="72" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="&#xE121;" Style="{StaticResource AchIcon}" Margin="0,1,6,0" Foreground="{DynamicResource TextBrushDarker}" />
                <TextBlock Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center"
                           Text="{Binding SummaryItems[0].PlaytimeSeconds, Mode=OneWay, Converter={StaticResource PlayTimeToStringConverter}}" />
                <TextBlock VerticalAlignment="Center" ToolTip="{Binding SummaryItems[0].LastUnlockLocal, Mode=OneWay, StringFormat='{}{0:g}'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SummaryItems[0].LastUnlockLocal, Mode=OneWay, FallbackValue={x:Null}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="  ·  Last unlock " /><Run Text="{Binding SummaryItems[0].LastUnlockLocal, Mode=OneWay, StringFormat='{}{0:d}'}" />
                </TextBlock>
            </StackPanel>
            <DockPanel Margin="0,12,0,0" HorizontalAlignment="Left">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Path Data="{DynamicResource FluentTrophyGeometry}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0"
                          Fill="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding SummaryItems[0].UnlockedAchievements, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" / " Foreground="{DynamicResource TextBrushDarker}" /><Run Text="{Binding SummaryItems[0].TotalAchievements, Mode=OneWay}" Foreground="{DynamicResource TextBrushDarker}" />
                    </TextBlock>
                    <TextBlock x:Name="AchProgressPercent" Margin="8,0,0,0" Style="{StaticResource AchCaption}" VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar Style="{StaticResource Fluent11ListProgressBar}" Width="200" VerticalAlignment="Center" Minimum="0"
                             Maximum="{Binding SummaryItems[0].TotalAchievements, Mode=OneWay, FallbackValue=1}"
                             Value="{Binding SummaryItems[0].UnlockedAchievements, Mode=OneWay, FallbackValue=0}" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Tag="AchRefresh" ToolTip="Refresh achievements of this game" Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource AchIcon}" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Tag="AchMoreMenu" Margin="8,0,0,0" ToolTip="More options" VerticalAlignment="Stretch" Focusable="False">
                    <TextBlock Text="&#xE712;" FontFamily="{DynamicResource FluentIconFont}" FontSize="14" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Margin="0,20,0,0" Style="{DynamicResource SurfaceCard}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="8,0,12,0">
                <StackPanel x:Name="AchTabs" DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton x:Name="AchTabAll" Style="{StaticResource AchTab}">
                        <TextBlock Style="{StaticResource AchTabText}"><Run Text="All" /><Run Text="  " /><Run Text="{Binding SummaryItems[0].TotalAchievements, Mode=OneWay}" Foreground="{DynamicResource TextBrushDarker}" /></TextBlock>
                    </RadioButton>
                    <RadioButton x:Name="AchTabUnlocked" Style="{StaticResource AchTab}">
                        <TextBlock Style="{StaticResource AchTabText}"><Run Text="Unlocked" /><Run Text="  " /><Run Text="{Binding SummaryItems[0].UnlockedAchievements, Mode=OneWay}" Foreground="{DynamicResource TextBrushDarker}" /></TextBlock>
                    </RadioButton>
                    <RadioButton x:Name="AchTabLocked" Style="{StaticResource AchTab}">
                        <TextBlock Style="{StaticResource AchTabText}"><Run Text="Locked" /><Run Text="  " /><Run x:Name="AchLockedCount" Foreground="{DynamicResource TextBrushDarker}" /></TextBlock>
                    </RadioButton>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource AchBarButton}" Tag="&#xE71C;" Uid="AchFilterMenu" ToolTip="Filter" />
                    <Button Style="{StaticResource AchBarButton}" Tag="&#xE8CB;" Uid="AchSortMenu" ToolTip="Sort" />
                </StackPanel>
                <Grid VerticalAlignment="Center" Margin="16,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" MaxWidth="260" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AchSearch" Grid.Column="1" Text="{Binding AchievementsControlBar.Search.Text, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Search achievements" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AchCaption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=AchSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource PanelSeparatorBrush}" />

            <Grid Grid.Row="2" Margin="8,8,4,4">
                <TextBlock Text="Loading achievements…" Style="{StaticResource AchCaption}" HorizontalAlignment="Center" Margin="0,24,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="No achievements" Style="{StaticResource AchCaption}" HorizontalAlignment="Center" Margin="0,24,0,0"
                           Visibility="{Binding ShowNoAchievementsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding Achievements}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                                <ItemsPresenter Margin="0,0,0,8" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" Margin="0,1,0,1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Margin="0,0,12,0" CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="{DynamicResource GridItemBackgroundBrush}">
                                        <Border CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource ImageStringToImageConverterCached}}"
                                                            Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                                            </Border.Background>
                                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Style="{DynamicResource ImageStrokeOverlay}" />
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource AchText}" />
                                            <TextBlock Text="&#xED1A;" FontFamily="{DynamicResource FluentIconFont}" FontSize="12"
                                                       Foreground="{DynamicResource TextBrushDarker}" Margin="8,2,0,0" VerticalAlignment="Center"
                                                       ToolTip="Hidden achievement"
                                                       Visibility="{Binding Hidden, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource AchCaption}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Description}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource AchCaption}"
                                               Text="{Binding UnlockTimeLocal, StringFormat='{}{0:d}', TargetNullValue=''}"
                                               ToolTip="{Binding UnlockTimeLocal, StringFormat='{}{0:g}', TargetNullValue=''}" />
                                    <Grid Grid.Column="3" Margin="24,0,0,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Style="{StaticResource AchRarityDot}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource AchRarityName}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource AchCaption}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"
                                                   TextAlignment="Right" Text="{Binding GlobalPercentText}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Grid>
