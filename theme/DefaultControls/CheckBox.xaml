<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        Background="{DynamicResource CheckBoxCheckMarkBkBrush}" />
                                <Border x:Name="BoxHover" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource SubtleHoverBrush}" Visibility="Collapsed" />
                                <Path x:Name="CheckIcon" Visibility="Collapsed" Data="M 5.5,10.5 L 8.5,13.5 L 14.5,6.5"
                                      Stroke="{DynamicResource TextOnAccentBrush}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      StrokeDashArray="12 12" StrokeDashCap="Round" />
                                <Path x:Name="IndeterminateIcon" Visibility="Collapsed" Data="M 6,10 L 14,10"
                                      Stroke="{DynamicResource TextOnAccentBrush}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" TargetName="Box" />
                            <Setter Property="BorderThickness" Value="0" TargetName="Box" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" TargetName="Box" />
                            <Setter Property="BorderThickness" Value="0" TargetName="Box" />
                        </Trigger>
                        <EventTrigger RoutedEvent="ButtonBase.Click">
                            <BeginStoryboard>
                                <Storyboard FillBehavior="Stop">
                                    <DoubleAnimation Storyboard.TargetName="CheckIcon" Storyboard.TargetProperty="StrokeDashOffset"
                                                     From="12" To="0" Duration="0:0:0.4">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False">
                            <Setter Property="StrokeDashArray" Value="{x:Null}" TargetName="CheckIcon" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="BoxHover" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Fluent11HeaderToggle" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7B3;" FontFamily="{DynamicResource FluentIconFont}" FontSize="16"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <Border x:Name="Indicator" Visibility="Collapsed" Width="16" Height="3" CornerRadius="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                Background="{DynamicResource AccentBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleSelectedBrush}" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Indicator" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Fluent11ToggleSwitch" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <DockPanel Background="Transparent">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                            <TextBlock x:Name="StateText" Text="Off" Width="28" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{TemplateBinding Foreground}" FontFamily="{DynamicResource FontFamily}"
                                       FontSize="{DynamicResource FontSize}" />
                            <Grid x:Name="Pill" Width="40" Height="20" VerticalAlignment="Center" Background="Transparent">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrongStrokeBrush}"
                                        Background="{DynamicResource CheckBoxCheckMarkBkBrush}" />
                                <Border x:Name="TrackHover" CornerRadius="10" Visibility="Collapsed"
                                        Background="{DynamicResource SubtleHoverBrush}" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource ControlStrongStrokeBrush}" />
                            </Grid>
                        </StackPanel>
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" TargetName="Track" />
                            <Setter Property="BorderThickness" Value="0" TargetName="Track" />
                            <Setter Property="Fill" Value="{DynamicResource TextOnAccentBrush}" TargetName="Knob" />
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="Knob" />
                            <Setter Property="Text" Value="On" TargetName="StateText" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="Pill">
                            <Setter Property="Visibility" Value="Visible" TargetName="TrackHover" />
                            <Setter Property="Width" Value="14" TargetName="Knob" />
                            <Setter Property="Height" Value="14" TargetName="Knob" />
                            <Setter Property="Margin" Value="3,0" TargetName="Knob" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
