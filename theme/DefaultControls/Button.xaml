<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="11,5,11,6" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="BottomLine" BorderBrush="{DynamicResource ControlStrokeBottomBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Overlay" Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        <TextBlock x:Name="FluentIcon" Visibility="Collapsed"
                                   FontFamily="{DynamicResource FluentIconFont}" FontSize="14" FontWeight="Normal"
                                   Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="&#xec3e;">
                            <Setter Property="Text" Value="&#xE710;" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="Content" />
                        </Trigger>
                        <Trigger Property="Content" Value="&#xef71;">
                            <Setter Property="Text" Value="&#xE71B;" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="Content" />
                        </Trigger>
                        <Trigger Property="Content" Value="&#xec53;">
                            <Setter Property="Text" Value="&#xE74D;" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="Content" />
                        </Trigger>
                        <Trigger Property="Content" Value="&#xef3e;">
                            <Setter Property="Text" Value="&#xE774;" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="Content" />
                        </Trigger>
                        <Trigger Property="Content" Value="+">
                            <Setter Property="Text" Value="&#xE710;" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="Content" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="FontFamily" Value="Marlett" />
                                <Condition Property="Content" Value="5" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Text" Value="&#xE70E;" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="Content" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="FontFamily" Value="Marlett" />
                                <Condition Property="Content" Value="6" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Text" Value="&#xE70D;" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="Content" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="FontFamily" Value="Marlett" />
                                <Condition Property="Content" Value="r" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Text" Value="&#xE711;" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FluentIcon" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="Content" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" TargetName="Overlay" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" TargetName="Overlay" />
                            <Setter Property="Opacity" Value="0.8" TargetName="Content" />
                        </Trigger>
                        <Trigger Property="BorderThickness" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BottomLine" />
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BottomLine" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Fluent11Primary">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BottomLine" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Fluent11Primary">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
